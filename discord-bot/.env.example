# UnionKitBot Discord controller - example environment.
#
# You normally do not edit this file by hand. Run:
#
#     npm run setup
#
# which asks for the four values that must be filled in, reads the mod's API
# secret from disk for you, and writes `.env` with the right permissions. Running
# it again is safe: existing answers are kept and unrelated lines are preserved.
#
# Then check everything with:
#
#     npm run doctor
#
# This file stays as the reference for every option and its default. `.env` is
# git-ignored and must never be committed. Secrets are never echoed back to
# Discord or written to logs.

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------

# Bot token from the Discord Developer Portal. Required.
# Developer Portal -> your app -> Bot -> Reset Token.
# Never share this value; reset it immediately if it leaks.
DISCORD_TOKEN=

# Application (client) id, used to register slash commands. Required.
# Developer Portal -> your app -> General Information -> Application ID.
# This is not the token and not the public key.
DISCORD_APPLICATION_ID=

# Guild id used to register slash commands instantly during development.
# Leave empty to register commands globally (propagation can take up to an hour).
DISCORD_GUILD_ID=

# Comma separated Discord user ids allowed to run administrative commands.
# At least one of DISCORD_ADMIN_USER_IDS or DISCORD_ADMIN_ROLE_IDS is required.
# Enable Developer Mode in Discord (Settings -> Advanced), then right-click a
# user or role and choose "Copy User ID" / "Copy Role ID".
DISCORD_ADMIN_USER_IDS=

# Comma separated Discord role ids allowed to run administrative commands.
DISCORD_ADMIN_ROLE_IDS=

# Optional: restrict the bot to a single guild. When set, commands from other
# guilds and DMs are ignored.
DISCORD_ALLOWED_GUILD_ID=

# ---------------------------------------------------------------------------
# Fabric mod control API
# ---------------------------------------------------------------------------

# Base URL of the Fabric mod control API. Must match `api.host`/`api.port` in
# the mod's config/unionkitbot.json. Required.
MOD_API_URL=http://127.0.0.1:8765

# Pre-shared secret. Must be identical to the mod's API secret, which lives in
# `.minecraft/config/unionkitbot/unionkitbot.secret` (or the UNIONKITBOT_API_SECRET
# environment variable on the mod side), and at least 16 characters. Required.
MOD_API_SECRET=

# Use wss:// instead of ws:// when the mod is fronted by a TLS proxy.
MOD_API_USE_TLS=false

# Accept self-signed certificates. Keep false unless you control the proxy.
MOD_API_ALLOW_INSECURE_TLS=false

# Protocol version this controller speaks. Must match the mod's
# ProtocolVersion.CURRENT (1 for this release).
MOD_PROTOCOL_VERSION=1

# ---------------------------------------------------------------------------
# Connection behaviour
# ---------------------------------------------------------------------------

# Milliseconds before an unanswered request is failed. Default: 10000
MOD_REQUEST_TIMEOUT_MS=10000

# Milliseconds without a heartbeat before the socket is considered dead.
# Default: 45000
MOD_HEARTBEAT_TIMEOUT_MS=45000

# Reconnect backoff bounds in milliseconds. Defaults: 1000 / 60000
MOD_RECONNECT_MIN_MS=1000
MOD_RECONNECT_MAX_MS=60000

# How many recent log lines / errors are retained in memory for /logs. Default: 200
LOG_BUFFER_SIZE=200

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info
