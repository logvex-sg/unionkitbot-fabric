{
  "name": "unionkitbot-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord controller for the UnionKitBot Fabric Minecraft mod",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "register-commands": "node dist/register-commands.js",
    "setup": "node dist/setup.js",
    "doctor": "node dist/doctor.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
